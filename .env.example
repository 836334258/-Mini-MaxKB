# L0: choose the active chat provider. Supported values: deepseek, gemini.
AI_PROVIDER=deepseek

# Optional system instruction shared by all chat providers.
AI_SYSTEM_PROMPT=You are a helpful knowledge-base assistant.

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_API_BASE_URL=https://api.deepseek.com

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Optional: use this when the terminal cannot inherit the Windows system proxy.
# AI_HTTPS_PROXY=http://127.0.0.1:7897
# AI_NO_PROXY=localhost,127.0.0.1

# L1: embedding models are configured independently from chat models.
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
