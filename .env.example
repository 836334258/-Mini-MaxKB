# L0: choose the active chat provider. Supported values: deepseek, gemini.
AI_PROVIDER=deepseek

# Optional system instruction shared by all chat providers.
AI_SYSTEM_PROMPT=You are a helpful knowledge-base assistant.

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_API_BASE_URL=https://api.deepseek.com

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# LangChain LC0: the official quickstart provider reads GOOGLE_API_KEY.
# When omitted, our lesson script safely reuses GEMINI_API_KEY on the server.
# GOOGLE_API_KEY=
LANGCHAIN_QUICKSTART_MODEL=google-genai:gemini-3.5-flash

# LangChain LC1B: model configuration is independent from Agent logic.
LANGCHAIN_MODEL_PROVIDER=google-genai
LANGCHAIN_MODEL=gemini-3.5-flash
LANGCHAIN_TEMPERATURE=0.2
LANGCHAIN_TIMEOUT_MS=120000
LANGCHAIN_MAX_TOKENS=2048
LANGCHAIN_MAX_RETRIES=2

# Optional: use this when the terminal cannot inherit the Windows system proxy.
# AI_HTTPS_PROXY=http://127.0.0.1:7897
# AI_NO_PROXY=localhost,127.0.0.1

# L1: embedding models are configured independently from chat models.
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768

# L3: local SQLite database used for conversations and messages.
# MINI_MAXKB_DATABASE_PATH=.mini-maxkb/mini-maxkb.sqlite
# MINI_MAXKB_INDEX_PATH=.mini-maxkb/l1-index.json
# MINI_MAXKB_STORAGE_PATH=.mini-maxkb/knowledge-bases

# L4: hybrid retrieval quality and reliability controls.
RAG_TOP_K=3
RAG_CANDIDATE_K=12
RAG_MIN_SCORE=0.45
RAG_SEMANTIC_WEIGHT=0.7
